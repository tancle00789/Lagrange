PK_AGENT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pk_agent
PK_AGENT_REDIS_URL=redis://localhost:6379/0
PK_AGENT_JWT_SECRET=dev-only-secret
PK_AGENT_CHECKPOINT_NS=dev
PK_AGENT_MODEL_BUDGET_MAX_CALLS=10
PK_AGENT_RATE_LIMIT_RPS=20
PK_AGENT_SSRF_ALLOWLIST=weknora-app,localhost
PK_AGENT_WEKNORA_BASE_URL=http://weknora-app:8080
# PK_AGENT_WEKNORA_API_KEY=          # scoped WeKnora API key; leave unset to use FakeKnowledgeProvider
# PK_AGENT_WEKNORA_DEFAULT_KB_ID=    # default knowledge base id
# PK_AGENT_WEKNORA_TENANT_KB_MAP=tenant-a:kb-xxx,tenant-b:kb-yyy
PK_AGENT_WEKNORA_TIMEOUT_SECONDS=10.0
PK_AGENT_WEKNORA_MAX_RETRIES=3
PK_AGENT_WEKNORA_SNIPPET_MAX_CHARS=500
# Literature subsystem (Phase 4')
PK_AGENT_EXTERNAL_HTTP_TIMEOUT=15.0
PK_AGENT_EXTERNAL_MAX_RESULTS=5
PK_AGENT_LITERATURE_PDF_MAX_BYTES=25000000
# PK_AGENT_GITHUB_TOKEN=             # optional; raises GitHub search rate limits
# PK_AGENT_CROSSREF_MAILTO=          # optional; joins the CrossRef polite pool
# PK_AGENT_SPRINGER_NATURE_API_KEY=  # optional; without it the nature source is skipped
